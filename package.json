{
  "name": "@averoa/core",
  "version": "2.3.1",
  "description": "Core of AveroaJS: builds the Express 5 app (security headers, sessions, CSRF, CORS, views, routes, error handling) and the averoa CLI",
  "main": "index.js",
  "types": "./index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./knexfile": {
      "types": "./knexfile.d.ts",
      "default": "./knexfile.js"
    },
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./*.d.ts",
      "default": "./*.js"
    },
    "./*": "./*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "env.js",
    "env.d.ts",
    "cors.js",
    "cors.d.ts",
    "csrf.js",
    "csrf.d.ts",
    "uploads.js",
    "uploads.d.ts",
    "testing.js",
    "testing.d.ts",
    "openapi.js",
    "openapi.d.ts",
    "redis.js",
    "redis.d.ts",
    "session-store.js",
    "session-store.d.ts",
    "rate-limit.js",
    "rate-limit.d.ts",
    "request-id.js",
    "request-id.d.ts",
    "health.js",
    "health.d.ts",
    "edge-js.js",
    "edge-js.d.ts",
    "morgan.js",
    "morgan.d.ts",
    "knexfile.js",
    "knexfile.d.ts",
    "command.js",
    "command.d.ts",
    "template/",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "types:exports": "node scripts/export-names.mjs --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/budiherma1/AveroaCore.git"
  },
  "keywords": [
    "averoajs",
    "express",
    "framework"
  ],
  "author": "Budi Hermawan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/budiherma1/AveroaCore/issues"
  },
  "homepage": "https://github.com/budiherma1/AveroaCore#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@averoa/routes": "^3.1.0",
    "@averoa/utilities": "^2.1.0",
    "@types/express": "^5.0.0",
    "@types/node": ">=20",
    "connect-redis": "^9.0.0",
    "edge.js": "^5.5.1",
    "express": "^5.1.0",
    "knex": "^3.1.0",
    "objection": "^3.1.5",
    "passport": "^0.7.0",
    "rate-limit-redis": "^6.0.2",
    "redis": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    },
    "@types/node": {
      "optional": true
    },
    "connect-redis": {
      "optional": true
    },
    "rate-limit-redis": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@averoa/routes": "^3.1.0",
    "@averoa/utilities": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "better-sqlite3": "^11.10.0",
    "connect-redis": "^9.0.0",
    "edge.js": "^5.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.1",
    "express": "^5.1.0",
    "globals": "^17.14.0",
    "knex": "^3.1.0",
    "objection": "^3.1.5",
    "passport": "^0.7.0",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
