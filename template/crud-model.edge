import { Model } from '@averoa/utilities';

class {{ model }} extends Model {
  static tableName = '{{ db }}';

  // false disables created_at/updated_at/deleted_at and soft delete
  static timestamp = true;

  // columns that are never serialized and never selectable through $select
  static hidden = [];

  static column = {
    id: {
      migration: (m) => m.table.increments(m.column).primary(),
      flag: { required: false },
    },
    email: {
      migration: (m) => m.table.string(m.column, 100).nullable(),
      seed: (f) => f.internet.email(),
      flag: { unique: true },
      validation: [{ run: (v) => v.validator.isEmail(String(v.value ?? '')), msg: 'email format required' }],
    },
  };
}

export default {{ model }};
