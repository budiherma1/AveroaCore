@if(http)
// HTTP test: the real app (testApp() from @averoa/core/testing), migrated and seeded, on a
// random port. The database is in-memory SQLite, or AVEROA_TEST_DB_URL (tests/helpers.js).
// Run: npm test -- tests/{{ file }}
import {
  describe, test, before, after,
} from 'node:test';
import assert from 'node:assert/strict';
import { testApp } from '@averoa/core/testing.js';
import { setTestEnv } from './helpers.js';

// before the app is built: the database and config are read from the environment
setTestEnv();

let app;

before(async () => {
  app = await testApp();
});

after(() => app?.close());

describe('{{ title }}', () => {
  test('GET /api answers JSON', async () => {
    // app.http(method, url, { body, form, token, headers }) resolves
    // { status, headers, body, text }
    const res = await app.http('GET', '/api');
    assert.equal(res.status, 200, res.text);
  });
});
@else
// Unit test, run with the built-in node:test runner: npm test -- tests/{{ file }}
import { describe, test, before } from 'node:test';
import assert from 'node:assert/strict';
import { setTestEnv } from './helpers.js';

// before anything imports @averoa/* or app code: config is read from the environment.
// Import app code dynamically below, after this line.
setTestEnv();

let helpers;

before(async () => {
  helpers = await import('#helpers');
});

describe('{{ title }}', () => {
  test('works', () => {
    assert.ok(helpers);
  });
});
@end
