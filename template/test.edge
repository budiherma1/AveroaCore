@if(http)
// HTTP test: the real app from @averoa/core's createApp(), migrated and seeded, on a
// random port. The database is in-memory SQLite, or AVEROA_TEST_DB_URL (tests/helpers.js).
// Run: npm test -- tests/{{ file }}
import {
  describe, test, before, after,
} from 'node:test';
import assert from 'node:assert/strict';
import { once } from 'node:events';
import path from 'node:path';
import {
  APP_ROOT, setTestEnv, client, usesTestDatabaseUrl,
} from './helpers.js';

// before anything imports @averoa/*: the database is built from the environment
setTestEnv();

let server;
let DB;
let http;

before(async () => {
  const { createApp } = await import('@averoa/core');
  ({ DB } = await import('@averoa/utilities'));
  const { app } = await createApp();

  const migrations = { directory: path.join(APP_ROOT, 'database/migrations'), loadExtensions: ['.js'] };
  if (usesTestDatabaseUrl()) await DB.migrate.rollback(migrations, true);
  await DB.migrate.latest(migrations);
  await DB.seed.run({ directory: path.join(APP_ROOT, 'database/seeds'), loadExtensions: ['.js'] });

  server = app.listen(0, '127.0.0.1');
  await once(server, 'listening');
  http = client(`http://127.0.0.1:${server.address().port}`);
});

after(async () => {
  if (server) {
    server.closeAllConnections?.();
    await new Promise((resolve) => { server.close(resolve); });
  }
  await DB?.destroy();
  const utilities = await import('@averoa/utilities');
  await utilities.closeQueue?.();
  const core = await import('@averoa/core');
  await core.closeRedis?.();
});

describe('{{ title }}', () => {
  test('GET /api answers JSON', async () => {
    const res = await http('GET', '/api');
    assert.equal(res.status, 200, res.text);
    // http(method, url, { body, token, headers }) resolves { status, body, text }
  });
});
@else
// Unit test, run with the built-in node:test runner: npm test -- tests/{{ file }}
import { describe, test, before } from 'node:test';
import assert from 'node:assert/strict';
import { setTestEnv } from './helpers.js';

// before anything imports @averoa/* or app code: config is read from the environment.
// Import app code dynamically below, after this line.
setTestEnv();

let helpers;

before(async () => {
  helpers = await import('#helpers');
});

describe('{{ title }}', () => {
  test('works', () => {
    assert.ok(helpers);
  });
});
@end
