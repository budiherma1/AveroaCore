/**
 * Who may do what with a {{ model }}. Register it in app/Providers/AuthProvider.js:
 *
 *   import { {{ model }} } from '#models';
 *   import {{ name }} from '#app/Policies/{{ name }}.js';
 *   policies() { return [..., [{{ model }}, {{ name }}]]; }
 *
 * Methods are named after abilities: Gate.allows(user, 'update', record) calls
 * update(user, record); routes use can('update', loader) from @averoa/utilities.
 * Return true to allow; anything else denies (403).
 */
class {{ name }} {
  /** Runs before every ability: true allows, false denies, undefined lets the ability decide. */
  before(user) {
    if (user.isAdmin?.() === true) return true;
    return undefined;
  }

  /** Gate.allows(user, 'view', record) */
  view() {
    return true;
  }

  /** No record yet: Gate.allows(user, 'create', {{ model }}) */
  create() {
    return true;
  }

  /** The owner (record.user_id) may change the record. */
  update(user, record) {
    return record.user_id != null && Number(record.user_id) === Number(user.id);
  }

  delete(user, record) {
    return this.update(user, record);
  }
}

export default {{ name }};
