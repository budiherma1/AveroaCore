import { Crud } from '@averoa/utilities';

// Crud resolves to { status: false, message, statusCode } on failure
// (400 bad filter, 404 not found, 422 validation, 500 other errors); answer
// with that status code (400 if a failure has none), 200 otherwise.
// Thrown/rejected errors are forwarded to the error handler by Express 5.
const send = (res, result) => res
  .status(result?.statusCode ?? (result?.status === false ? 400 : 200))
  .json(result);

class {{ controller }} {
  async create(req, res) {
    send(res, await Crud.create('{{ model }}', req));
  }

  async findAll(req, res) {
    send(res, await Crud.findAll('{{ model }}', req));
  }

  async findOne(req, res) {
    send(res, await Crud.findOne('{{ model }}', req));
  }

  async update(req, res) {
    send(res, await Crud.update('{{ model }}', req));
  }

  async delete(req, res) {
    send(res, await Crud.delete('{{ model }}', req));
  }
}

export default new {{ controller }}();
